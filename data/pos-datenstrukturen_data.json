    "HashSet": {
      "label": "HashSet<int>",
      "kind": "Generic Collection",
      "namespace": "System.Collections.Generic",
      "description": "Speichert NUR eindeutige Werte. Ein doppeltes Add wird ignoriert (kein Fehler). Keine garantierte Reihenfolge.",
      "visualType": "set",
      "seed": { "items": [1, 2, 3, 4, 5] },
      "methods": {
        "Add":           { "label": "Add(T)", "params": [ { "name": "item", "label": "Wert (int)", "type": "int", "placeholder": "6" } ], "signature": "public bool Add(T item)", "returnType": "bool", "description": "Fuegt hinzu. Gibt false zurueck wenn schon vorhanden (Duplikat ignoriert)." },
