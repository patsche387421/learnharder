      "seed": { "items": ["Erdgeschoss", "1. Stock", "2. Stock"] },
      "methods": {
        "Push":    { "label": "Push(T)", "params": [ { "name": "item", "label": "Element", "type": "string", "placeholder": "3. Stock" } ], "signature": "public void Push(T item)", "returnType": "void", "description": "Legt ein Element oben auf den Stack." },
        "Pop":     { "label": "Pop()", "params": [], "signature": "public T Pop()", "returnType": "T", "description": "Entfernt das oberste Element und gibt es zurueck. InvalidOperationException wenn leer." },
