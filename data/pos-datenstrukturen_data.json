      "description": "Typisierte, dynamisch wachsende Liste. Zugriff per Index. Anzahl ueber .Count (nicht .Length).",
      "visualType": "list",
      "seed": { "items": ["Anna", "Max", "Julia"] },
      "methods": {
        "Add":     { "label": "Add(T)", "params": [ { "name": "item", "label": "Element", "type": "string", "placeholder": "Lena" } ], "signature": "public void Add(T item)", "returnType": "void", "description": "Fuegt ein Element am Ende hinzu." },
        "Insert":  { "label": "Insert(index, T)", "params": [ { "name": "index", "label": "Index", "type": "int", "placeholder": "1" }, { "name": "item", "label": "Element", "type": "string", "placeholder": "Lena" } ], "signature": "public void Insert(int index, T item)", "returnType": "void", "description": "Fuegt am Index ein \u2013 alle nachfolgenden rutschen nach rechts." },
        "Remove":  { "label": "Remove(T)", "params": [ { "name": "item", "label": "Element", "type": "string", "placeholder": "Max" } ], "signature": "public bool Remove(T item)", "returnType": "bool", "description": "Entfernt das erste Vorkommen. true bei Erfolg." },
        "RemoveAt":{ "label": "RemoveAt(index)", "params": [ { "name": "index", "label": "Index", "type": "int", "placeholder": "0" } ], "signature": "public void RemoveAt(int index)", "returnType": "void", "description": "Entfernt das Element am Index." },
