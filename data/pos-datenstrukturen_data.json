      "namespace": "System.Collections.Generic",
      "description": "FIFO \u2013 First In, First Out. Enqueue stellt hinten an, Dequeue nimmt vorne weg. Wie eine Warteschlange.",
      "visualType": "queue",
      "seed": { "items": ["Anna", "Max", "Julia"] },
      "methods": {
        "Enqueue": { "label": "Enqueue(T)", "params": [ { "name": "item", "label": "Element", "type": "string", "placeholder": "Tom" } ], "signature": "public void Enqueue(T item)", "returnType": "void", "description": "Stellt ein Element hinten an." },
