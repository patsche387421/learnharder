        "IndexOf": { "label": "IndexOf(T)", "params": [ { "name": "item", "label": "Element", "type": "string", "placeholder": "Julia" } ], "signature": "public int IndexOf(T item)", "returnType": "int", "description": "Index des ersten Vorkommens, sonst -1." },
        "Sort":    { "label": "Sort()", "params": [], "signature": "public void Sort()", "returnType": "void", "description": "Sortiert die Elemente (Standardcomparer)." },
        "Clear":   { "label": "Clear()", "params": [], "signature": "public void Clear()", "returnType": "void", "description": "Entfernt alle Elemente." },
        "Count":   { "label": "Count (Eigenschaft)", "params": [], "signature": "public int Count { get; }", "returnType": "int", "description": "Anzahl der Elemente." }
      }
    },

