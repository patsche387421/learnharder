      "description": "Schreibgeschuetztes Array von chars (UTF-16). Unveraenderlich \u2013 jede Methode gibt einen NEUEN String zurueck.",
      "visualType": "array",
      "seed": { "value": "Hallo Welt" },
      "methods": {
        "Length":        { "label": "Length (Eigenschaft)", "params": [], "signature": "public int Length { get; }", "returnType": "int", "description": "Gibt die Anzahl der Zeichen zurueck." },
        "IndexOf":       { "label": "IndexOf(string)", "params": [ { "name": "value", "label": "Suchwert", "type": "string", "placeholder": "Welt" } ], "signature": "public int IndexOf(string value)", "returnType": "int", "description": "Index des ersten Vorkommens, sonst -1." },
        "Substring2":    { "label": "Substring(start, length)", "params": [ { "name": "startIndex", "label": "startIndex", "type": "int", "placeholder": "0" }, { "name": "length", "label": "length", "type": "int", "placeholder": "5" } ], "signature": "public string Substring(int startIndex, int length)", "returnType": "string", "description": "Teilzeichenfolge ab startIndex mit angegebener Laenge." },
        "Replace":       { "label": "Replace(string, string)", "params": [ { "name": "oldValue", "label": "oldValue", "type": "string", "placeholder": "Welt" }, { "name": "newValue", "label": "newValue", "type": "string", "placeholder": "POS" } ], "signature": "public string Replace(string oldValue, string newValue)", "returnType": "string", "description": "Ersetzt alle Vorkommen von oldValue durch newValue." },
        "ToUpper":       { "label": "ToUpper()", "params": [], "signature": "public string ToUpper()", "returnType": "string", "description": "Gibt den String in Grossbuchstaben zurueck." },
        "Contains":      { "label": "Contains(string)", "params": [ { "name": "value", "label": "Suchwert", "type": "string", "placeholder": "Welt" } ], "signature": "public bool Contains(string value)", "returnType": "bool", "description": "true wenn der Teilstring enthalten ist." },
        "Trim":          { "label": "Trim()", "params": [], "signature": "public string Trim()", "returnType": "string", "description": "Entfernt fuehrende und nachfolgende Leerzeichen." }
      }
    },

    "List": {
