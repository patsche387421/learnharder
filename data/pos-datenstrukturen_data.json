        "IntersectWith": { "label": "IntersectWith(menge)", "params": [ { "name": "other", "label": "andere Menge (z.B. 3,4,5,6,7)", "type": "intset", "placeholder": "3,4,5,6,7" } ], "signature": "public void IntersectWith(IEnumerable<T> other)", "returnType": "void", "description": "Schnittmenge: behaelt nur Werte, die in BEIDEN Mengen sind." },
        "UnionWith":     { "label": "UnionWith(menge)", "params": [ { "name": "other", "label": "andere Menge (z.B. 6,7,8)", "type": "intset", "placeholder": "6,7,8" } ], "signature": "public void UnionWith(IEnumerable<T> other)", "returnType": "void", "description": "Vereinigung: nimmt alle Werte aus beiden Mengen auf." },
        "ExceptWith":    { "label": "ExceptWith(menge)", "params": [ { "name": "other", "label": "andere Menge (z.B. 4,5)", "type": "intset", "placeholder": "4,5" } ], "signature": "public void ExceptWith(IEnumerable<T> other)", "returnType": "void", "description": "Differenz: entfernt alle Werte, die in der anderen Menge vorkommen." },
        "Clear":         { "label": "Clear()", "params": [], "signature": "public void Clear()", "returnType": "void", "description": "Leert die Menge." },
