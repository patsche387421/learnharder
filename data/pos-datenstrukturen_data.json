        "Contains":{ "label": "Contains(T)", "params": [ { "name": "item", "label": "Element", "type": "string", "placeholder": "Anna" } ], "signature": "public bool Contains(T item)", "returnType": "bool", "description": "true wenn das Element in der Queue ist." },
        "Clear":   { "label": "Clear()", "params": [], "signature": "public void Clear()", "returnType": "void", "description": "Leert die Queue." },
        "Count":   { "label": "Count (Eigenschaft)", "params": [], "signature": "public int Count { get; }", "returnType": "int", "description": "Anzahl der Elemente." }
      }
    },

    "Dictionary": {
      "label": "Dictionary<int, string>",
      "kind": "Generic Collection",
      "namespace": "System.Collections.Generic",
      "description": "Eindeutige Schluessel-Wert-Paare. Zugriff per Key in O(1). Reihenfolge NICHT garantiert.",
      "visualType": "dictionary",
      "seed": { "entries": [ { "key": 1, "value": "Huber" }, { "key": 2, "value": "Mayer" }, { "key": 3, "value": "Wimmer" } ] },
      "methods": {
        "Add":         { "label": "Add(key, value)", "params": [ { "name": "key", "label": "Key (int)", "type": "int", "placeholder": "4" }, { "name": "value", "label": "Value (string)", "type": "string", "placeholder": "Schmidt" } ], "signature": "public void Add(TKey key, TValue value)", "returnType": "void", "description": "Fuegt ein Paar hinzu. ArgumentException wenn Key existiert." },
        "Remove":      { "label": "Remove(key)", "params": [ { "name": "key", "label": "Key (int)", "type": "int", "placeholder": "2" } ], "signature": "public bool Remove(TKey key)", "returnType": "bool", "description": "Entfernt den Eintrag mit diesem Key." },
        "ContainsKey": { "label": "ContainsKey(key)", "params": [ { "name": "key", "label": "Key (int)", "type": "int", "placeholder": "1" } ], "signature": "public bool ContainsKey(TKey key)", "returnType": "bool", "description": "true wenn der Key vorhanden ist." },
        "TryGetValue": { "label": "TryGetValue(key, out value)", "params": [ { "name": "key", "label": "Key (int)", "type": "int", "placeholder": "1" } ], "signature": "public bool TryGetValue(TKey key, out TValue value)", "returnType": "bool", "description": "Sicherer Zugriff ohne Exception bei fehlendem Key." },
        "Clear":       { "label": "Clear()", "params": [], "signature": "public void Clear()", "returnType": "void", "description": "Entfernt alle Eintraege." },
        "Count":       { "label": "Count (Eigenschaft)", "params": [], "signature": "public int Count { get; }", "returnType": "int", "description": "Anzahl der Paare." }
      }
    },

